# ============================================================
# ICD Voice Assistant - Configuration
# ============================================================

# Server Network Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local Server Audio Playback (true: play on PC speakers, false: only stream to ESP32/Web)
SERVER_AUDIO_PLAYBACK=false

# Whisper Speech-to-Text Model
# Options: tiny, base, small, medium, large-v3
# Recommendation: "base" for fast CPU/laptop inference, "small" or "large-v3" if GPU is available
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi

# LLM Provider Configuration
# Options: "auto", "gemini", "ollama"
# "auto": uses Gemini if GEMINI_API_KEY is present, otherwise falls back to Ollama
LLM_PROVIDER=auto

# 1) Google Gemini (Cloud API - High speed, low memory, no local GPU needed)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2) Ollama (Local LLM - 100% Offline & Private)
# Install from: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=15.0

# Optional Prompt Normalization (true: calls LLM to clean grammar before answering, false: direct answer for minimum latency)
ENABLE_LLM_NORMALIZATION=false

# Edge TTS (Neural Voice)
# Options: "vi-VN-HoaiMyNeural" (Female), "vi-VN-NamMinhNeural" (Male)
TTS_VOICE=vi-VN-HoaiMyNeural
