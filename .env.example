# ============================================================
# ICD Voice Assistant - Root Configuration Template
# ============================================================

# Network & Server Settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Local Server Audio Output (true: play on PC speaker, false: stream only to ESP32/Web)
SERVER_AUDIO_PLAYBACK=false

# Whisper Speech-to-Text Model
# Options: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_LANGUAGE=vi

# LLM Provider Configuration
# Options: "auto", "gemini", "ollama"
LLM_PROVIDER=auto

# 1) Google Gemini (Recommended for fast cloud response without high GPU/VRAM)
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2) Ollama (Local LLM for 100% private offline inference)
# Download at: https://ollama.com/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OLLAMA_TIMEOUT=15.0

# Optional Prompt Normalization (false: lowest latency, true: grammatical cleanup)
ENABLE_LLM_NORMALIZATION=false

# Microsoft Edge Neural TTS Voice
# Vietnamese Voices: "vi-VN-HoaiMyNeural" (Female), "vi-VN-NamMinhNeural" (Male)
TTS_VOICE=vi-VN-HoaiMyNeural
